{
    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "launch",
            "name": "jlink",
            "servertype": "jlink",
            "interface": "swd",
            "executable": "${workspaceFolder}/build/Debug/stm32f1xx_gcc.elf",
            "runToEntryPoint": "main",
            "device": "STM32F103C8",
            "serverArgs": ["-speed", "8000"]
        },
        {
            "name": "Wokwi GDB",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/stm32f1xx_gcc.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "${config:cortex-debug.armToolchainPath}/arm-none-eabi-gdb.exe",
            "miDebuggerServerAddress": "localhost:3333"
        }
    ]
}
